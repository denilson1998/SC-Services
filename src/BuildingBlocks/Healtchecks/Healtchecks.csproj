		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>Sitec.Delivery.$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>Sitec.Delivery.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
